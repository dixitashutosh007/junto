rules_version = '2';

// Junto reads and writes Firestore only from the server, through the Admin
// SDK in Next.js API routes. The Admin SDK bypasses these rules, and the web
// and mobile clients never talk to Firestore directly.
//
// So every direct client request is denied. This closes the database to
// anyone holding the public Firebase config (API key, project ID), which ships
// in the browser bundle. Access control lives in src/lib/api-auth.ts.
//
// If a client feature ever needs direct Firestore access (e.g. realtime
// listeners), add a narrowly scoped rule for that collection here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
